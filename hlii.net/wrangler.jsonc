{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hlii-net",
  "main": "./src/index.js",
  "compatibility_date": "2026-05-20",
  "routes": [
    {
      "pattern": "hlii.net",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
