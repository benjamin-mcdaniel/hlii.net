---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Harbor Legal Independent Index" activeNav="home">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">MVP - Public preview</p>
      <h1>Tracking legislative bills and court rulings.</h1>
      <p class="lead">
        Harbor Legal Independent Index publishes data-driven reports on how legislative activity and court rulings are
        shifting over time - counts, mix, pace, and the structural reasons behind the changes.
        New reports drop as PDFs.
      </p>
      <div class="btn-row">
        <a class="btn btn-accent" href="/reports">Read the latest report</a>
        <a class="btn btn-outline" href="/method">How we count</a>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="grid grid-3">
        <article class="surface">
          <div class="card-label">What we track</div>
          <div class="card-value">Bills</div>
          <p class="card-copy">
            Federal and state bills introduced, advanced, and signed - broken out by topic,
            sponsor party, and stage.
          </p>
        </article>
        <article class="surface">
          <div class="card-label">What we track</div>
          <div class="card-value">Rulings</div>
          <p class="card-copy">
            Appellate and supreme court rulings - affirm, reverse, remand - with reasoning
            tags and downstream effect.
          </p>
        </article>
        <article class="surface">
          <div class="card-label">What we publish</div>
          <div class="card-value">Reports</div>
          <p class="card-copy">
            Periodic PDFs - for example "fiscal bills up 5% over the last 2 years" or
            "bill output down 50% under a 50/50 split."
          </p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Example findings</p>
          <h2>The kind of data we surface</h2>
        </div>
        <a href="/reports">All reports -&gt;</a>
      </div>
      <div class="surface">
        <div class="signal-stack">
          <div class="signal-item">Fiscal bills introduced rose ~5% over the last 2 years.</div>
          <div class="signal-item">Bill output dropped ~50% during periods of 50/50 chamber splits.</div>
          <div class="signal-item">Reversal rate on appellate rulings trended up in regulatory cases.</div>
          <div class="signal-item">Median time from introduction to vote stretched by ~18%.</div>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
