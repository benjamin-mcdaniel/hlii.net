---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  activeNav?: "home" | "reports" | "browse" | "method";
}

const {
  title,
  description = "Harbor Legal Independent Index tracks American legal-source movement across legislatures and higher courts, then packages the aggregate record for reports, APIs, and future MCP access.",
  activeNav
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <img class="brand-mark" src="/logo-harbor.svg" alt="Harbor Legal Independent Index logo" width="40" height="40" />
          <span class="brand-kicker">HLII</span>
          <span class="brand-text">Harbor Legal Independent Index</span>
        </a>
        <nav class="nav-links">
          <a href="/" class:list={{ active: activeNav === "home" }}>Overview</a>
          <a href="/search/" class:list={{ active: activeNav === "browse" }}>Coverage</a>
          <a href="/reports/" class:list={{ active: activeNav === "reports" }}>Reports</a>
          <a href="/method/" class:list={{ active: activeNav === "method" }}>Method</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>Harbor Legal Independent Index is an aggregate public-record project. Nothing here is legal advice.</span>
        <span>MVP build: reports now, public data endpoint next, MCP access later.</span>
      </div>
    </footer>
  </body>
</html>
